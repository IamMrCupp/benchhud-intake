#!/bin/sh
set -e

SETTINGS=/var/lib/benchhud-intake/settings.env

if [ "$1" = "configure" ]; then
    if ! getent passwd benchhud-intake >/dev/null; then
        useradd --system --user-group --home-dir /var/lib/benchhud-intake \
            --no-create-home --shell /usr/sbin/nologin benchhud-intake
    fi
    install -d -o benchhud-intake -g benchhud-intake -m 0750 /var/lib/benchhud-intake

    # The default port moved from 8000 to 8401 (bench-suite gives each service
    # its own). Pin the port in settings.env so a later upgrade can tell the two
    # apart: a fresh install records 8401; an upgrade from before the move
    # (no port line yet) keeps 8000, so benchhud and bookmarks keep working.
    if ! grep -qs '^[[:space:]]*INTAKE_PORT[[:space:]]*=' "$SETTINGS"; then
        if [ -n "$2" ]; then
            port=8000
        else
            port=8401
        fi
        (
            umask 077
            [ -s "$SETTINGS" ] && [ -n "$(tail -c1 "$SETTINGS")" ] && echo >>"$SETTINGS"
            echo "INTAKE_PORT=$port" >>"$SETTINGS"
        )
        if [ -n "$2" ]; then
            echo "benchhud-intake: kept on port 8000 (INTAKE_PORT in $SETTINGS);" \
                "new installs use 8401." >&2
        fi
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable benchhud-intake.service >/dev/null 2>&1 || true
    # Restart on upgrade; on a fresh install there's no password yet, and the
    # service refuses to start without one (by design).
    if [ -n "$2" ]; then
        systemctl try-restart benchhud-intake.service >/dev/null 2>&1 || true
    fi
fi

if [ -z "$2" ]; then
    cat <<'MSG'

benchhud-intake is installed. Set a password, then start it:

    sudo benchhud-intake set-password
    sudo systemctl start benchhud-intake

It listens on 127.0.0.1:8401. For a tablet on your LAN, add INTAKE_HOST=0.0.0.0
to /var/lib/benchhud-intake/settings.env and restart it. It holds customer
records: never expose it to the internet.

MSG
fi
exit 0
